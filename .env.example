# Copy to .env. Every key is optional: with none set, the engine runs in offline
# mock mode (deterministic extractors) and the whole demo still works.

# LLM providers, tried in this order. All three expose OpenAI-compatible endpoints.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (defaults live in src/decision_engine/llm/client.py)
# GROQ_MODEL=
# GEMINI_MODEL=
# OPENROUTER_MODEL=

# mock | auto   (auto = use the first provider with a key, fall back to mock on error)
DE_LLM_MODE=auto
# Samples per extraction for the self-consistency signal (real LLM mode)
DE_LLM_SAMPLES=3
# Where the hash-chained audit log lives
DE_AUDIT_DB=runs/audit.db
# Public demo guard: max real-LLM decisions per client IP per hour
DE_RATE_LIMIT_PER_HOUR=30
