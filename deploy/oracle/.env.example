# Copy to /opt/apps/.env on the server (never commit the real one).
# Apps are served at <name>.$DOMAIN, so point a wildcard DNS record *.$DOMAIN at the VM's public IP.
DOMAIN=example.com
EMAIL=you@example.com

# Optional, shared by apps that read them
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
